{
  "expo": {
    "name": "flashami-money-app",
    "slug": "flashami-money-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "flashamimoneyapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.kipeo22.flashamimoneyapp",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kipeo22.flashamimoneyapp",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "レシート画像を選択するために写真ライブラリへアクセスします。",
          "cameraPermission": "レシート画像を撮影するためにカメラへアクセスします。",
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "431af3f0-01db-443c-a127-6462729dc632"
      }
    },
    "owner": "kipeo22"
  }
}
